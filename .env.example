# ============================================================
# ARIA — environment configuration (copy to .env and fill in)
# .env is gitignored. Never commit real secrets.
# ============================================================

# --- App ---
ARIA_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM provider (groq | ollama) ---
LLM_PROVIDER=groq
# Groq (free key: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama (local fallback). In Docker use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Embeddings (local, via Ollama)
EMBED_MODEL=nomic-embed-text

# --- Razorpay (test mode — free; https://dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Datastores ---
# For local (host) runs. Ports 5433/6380 avoid clashing with any local
# Postgres/Redis already on the default 5432/6379.
DATABASE_URL=postgresql+asyncpg://aria:aria@localhost:5433/aria
REDIS_URL=redis://localhost:6380/0
# NOTE: inside docker-compose the hosts become 'postgres:5432' and 'redis:6379'
# (compose sets these via environment overrides automatically)

# --- Security ---
# 32-byte urlsafe key for AES-256-GCM PII encryption.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=
# Dashboard JWT signing secret
DASHBOARD_JWT_SECRET=change-me-in-production
